{
  "title": "Security Onion HO-NDR-001 Visibility Rollup Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visibility_contract_id",
    "sample_or_runtime_scope",
    "capture_status",
    "achieved_status",
    "public_safe_status",
    "cross_source_corroboration_captured",
    "splunk_search_executed",
    "cribl_route_proven",
    "wazuh_route_proven",
    "security_onion_runtime_proven",
    "zeek_completeness_proven",
    "suricata_detection_quality_proven",
    "wazuh_agent_summary",
    "security_onion_module_summary",
    "suricata_summary",
    "zeek_summary",
    "splunk_correlation_placeholder",
    "cribl_route_placeholder",
    "proof_ceiling",
    "blocked_claims",
    "next_gate"
  ],
  "properties": {
    "visibility_contract_id": {
      "type": "string",
      "const": "HO-NDR-001-SANITIZED-VISIBILITY-ROLLUP"
    },
    "sample_or_runtime_scope": {
      "type": "string",
      "enum": [
        "sample_only",
        "sanitized_private_runtime_rollup"
      ]
    },
    "capture_status": {
      "type": "string",
      "const": "NOT_CAPTURED_SAMPLE_ONLY"
    },
    "achieved_status": {
      "type": "string",
      "const": "NOT_CAPTURED_SAMPLE_ONLY"
    },
    "public_safe_status": {
      "type": "string",
      "const": "NOT_PUBLIC_SAFE"
    },
    "cross_source_corroboration_captured": {
      "type": "boolean",
      "const": false
    },
    "splunk_search_executed": {
      "type": "boolean",
      "const": false
    },
    "cribl_route_proven": {
      "type": "boolean",
      "const": false
    },
    "wazuh_route_proven": {
      "type": "boolean",
      "const": false
    },
    "security_onion_runtime_proven": {
      "type": "boolean",
      "const": false
    },
    "zeek_completeness_proven": {
      "type": "boolean",
      "const": false
    },
    "suricata_detection_quality_proven": {
      "type": "boolean",
      "const": false
    },
    "wazuh_agent_summary": {
      "$ref": "#/$defs/bounded_summary"
    },
    "security_onion_module_summary": {
      "$ref": "#/$defs/bounded_summary"
    },
    "suricata_summary": {
      "$ref": "#/$defs/bounded_summary"
    },
    "zeek_summary": {
      "$ref": "#/$defs/bounded_summary"
    },
    "splunk_correlation_placeholder": {
      "$ref": "#/$defs/bounded_summary"
    },
    "cribl_route_placeholder": {
      "$ref": "#/$defs/bounded_summary"
    },
    "proof_ceiling": {
      "type": "string",
      "const": "VALIDATION_CONTRACT_HARDENED_ONLY"
    },
    "blocked_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "runtime_active",
          "signal_observed",
          "public_safe_proof",
          "production_ndr",
          "cross_source_corroboration_captured",
          "security_onion_runtime_proven",
          "splunk_search_executed",
          "cribl_route_proven",
          "wazuh_route_proven",
          "zeek_completeness_proven",
          "suricata_detection_quality_proven",
          "raw_pcap_artifact",
          "private_identifier_publication"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "next_gate": {
      "type": "string",
      "const": "RUNTIME_CAPTURE_APPROVAL_REQUIRED_BEFORE_ANY_EVIDENCE_OR_PROOF_PROMOTION"
    }
  },
  "$defs": {
    "bounded_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "public_safe",
        "blocked_from_public_claim"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_captured_sample_only",
            "placeholder_not_executed",
            "not_routed",
            "not_proven"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "public_safe": {
          "type": "boolean",
          "const": false
        },
        "blocked_from_public_claim": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
