          "Action": "PolicyApplied",
          "ChangeWindow": "approved-policy"
        }
      },
      {
        "id": "neg-005-lab-maintenance-log-query",
        "description": "Documented lab maintenance querying logs",
        "telemetry_source": "Sysmon Event ID 1",
        "behavior": "log query without clear",
        "expected_match": false,
        "event": {
          "EventID": 1,
          "Channel": "Microsoft-Windows-Sysmon/Operational",
          "Image": "\\Windows\\System32\\wevtutil.exe",
