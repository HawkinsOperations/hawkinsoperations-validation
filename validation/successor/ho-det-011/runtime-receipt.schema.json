{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hawkinsoperations.local/schemas/ho-det-011-runtime-receipt.schema.json",
  "title": "HO-DET-011 Private Runtime Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "run_id",
    "correlation_id",
    "host",
    "user",
    "service_name",
    "benign_binary",
    "local_system_7045_count",
    "local_security_4697_count",
    "local_sysmon_1_count",
    "wazuh_query_exit_code",
    "wazuh_matching_lines",
    "service_absent",
    "minimum_success",
    "splunk_status",
    "raw_private_evidence_public",
    "ai_decided_disposition",
    "human_review_required",
    "public_safe",
    "public_safe_status"
  ],
  "properties": {
    "schema": {
      "const": "ho-det-011-runtime-receipt-private-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^HO-DET-011-RUNTIME-[0-9]{8}-[0-9]{6}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^HO_DET_011_[0-9]{8}_[0-9]{6}_[0-9a-f]{8}$"
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "user": {
      "type": "string",
      "minLength": 1
    },
    "service_name": {
      "type": "string",
      "minLength": 1
    },
    "benign_binary": {
      "type": "string",
      "minLength": 1
    },
    "service_create_exit_code": {
      "type": ["integer", "null"]
    },
    "local_system_7045_count": {
      "type": "integer",
      "minimum": 0
    },
    "local_security_4697_count": {
      "type": "integer",
      "minimum": 0
    },
    "local_sysmon_1_count": {
      "type": "integer",
      "minimum": 0
    },
    "wazuh_query_exit_code": {
      "const": 0
    },
    "wazuh_matching_lines": {
      "type": "integer",
      "minimum": 1
    },
    "cleanup_exit_code": {
      "type": ["integer", "null"]
    },
    "service_absent": {
      "const": true
    },
    "minimum_success": {
      "const": true
    },
    "missing_fields": {
      "type": ["array", "null"],
      "maxItems": 0
    },
    "splunk_status": {
      "const": "NOT_VERIFIED"
    },
    "raw_private_evidence_public": {
      "const": false
    },
    "ai_decided_disposition": {
      "const": false
    },
    "human_review_required": {
      "const": true
    },
    "public_safe": {
      "const": false
    },
    "public_safe_status": {
      "enum": ["REVIEW_REQUIRED", "NOT_PUBLIC_SAFE"]
    }
  }
}
