{
  "detection_id": "HO-DET-011",
  "case_scope": "controlled-test_windows_service_creation",
  "validation_scope": "controlled-test fixtures only",
  "source_reference": "hawkinsoperations-detections/detections/successor/ho-det-011",
  "source_scope": [
    "Windows System Event ID 7045 from Service Control Manager service install telemetry",
    "Windows Security Event ID 4697 where service installation auditing is available",
    "Sysmon Event ID 1 process creation context for service creation tooling"
  ],
  "cases": {
    "positive": [
      {
        "id": "pos-001-system-7045-appdata-imagepath",
        "description": "Windows System 7045 service install with suspicious ImagePath under AppData",
        "telemetry_source": "Windows System 7045",
        "behavior": "suspicious ImagePath under user profile application data path",
        "expected_match": true,
        "event": {
          "EventID": 7045,
          "Channel": "System",
          "Provider_Name": "Service Control Manager",
          "ServiceName": "CacheUpdater",
          "ImagePath": "\\Users\\Default\\AppData\\Local\\CacheUpdater\\cacheupdater.exe",
          "ServiceType": "user mode service",
          "StartType": "auto start"
        }
      },
      {
        "id": "pos-002-system-7045-servicefilename-windows-temp",
        "description": "Windows System 7045 service install with suspicious ServiceFileName under Windows Temp",
        "telemetry_source": "Windows System 7045",
        "behavior": "suspicious ServiceFileName under temporary operating system path",
        "expected_match": true,
        "event": {
          "EventID": 7045,
          "Channel": "System",
          "Provider_Name": "Service Control Manager",
          "ServiceName": "TempServiceLoader",
          "ServiceFileName": "\\Windows\\Temp\\tempsvcloader.exe",
          "ServiceType": "user mode service",
          "StartType": "demand start"
        }
      },
      {
        "id": "pos-003-security-4697-servicefilename-users-public",
        "description": "Windows Security 4697 service install with suspicious ServiceFileName under Users Public",
        "telemetry_source": "Windows Security 4697",
        "behavior": "Security event ServiceFileName alias coverage",
        "expected_match": true,
        "event": {
          "EventID": 4697,
          "Channel": "Security",
          "ServiceName": "PublicLibraryUpdater",
          "ServiceFileName": "\\Users\\Public\\Libraries\\publiclibupdater.exe",
          "ServiceType": "user mode service",
          "StartType": "auto start",
          "SubjectUserName": "controlled-test-admin"
        }
      },
      {
        "id": "pos-004-sysmon-sc-create-binpath-public",
        "description": "Sysmon Event ID 1 process context using sc.exe create with binPath pointing to a suspicious path",
        "telemetry_source": "Sysmon Event ID 1",
        "behavior": "sc.exe create command with binPath service target",
        "expected_match": true,
        "event": {
          "EventID": 1,
          "Channel": "Microsoft-Windows-Sysmon/Operational",
          "Provider_Name": "Microsoft-Windows-Sysmon",
          "Image": "\\Windows\\System32\\sc.exe",
          "OriginalFileName": "sc.exe",
          "CommandLine": "sc.exe create PublicCache binPath= \\Users\\Public\\Libraries\\publiccache.exe start= auto",
          "ParentImage": "\\Windows\\System32\\cmd.exe"
        }
      },
      {
        "id": "pos-005-sysmon-powershell-new-service-programdata",
        "description": "Sysmon Event ID 1 process context using PowerShell New-Service with suspicious service path",
        "telemetry_source": "Sysmon Event ID 1",
        "behavior": "PowerShell New-Service command with suspicious binary path",
        "expected_match": true,
        "event": {
          "EventID": 1,
          "Channel": "Microsoft-Windows-Sysmon/Operational",
          "Provider_Name": "Microsoft-Windows-Sysmon",
          "Image": "\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
          "OriginalFileName": "PowerShell.EXE",
          "CommandLine": "powershell.exe -NoProfile -Command New-Service -Name ProgramDataCache -BinaryPathName \\ProgramData\\CacheSvc\\cache.exe",
          "ParentImage": "\\Windows\\System32\\cmd.exe"
        }
      },
      {
        "id": "pos-006-system-7045-interpreter-backed-rundll32",
        "description": "Windows System 7045 service install with interpreter-backed service target",
        "telemetry_source": "Windows System 7045",
        "behavior": "interpreter-backed service image path",
        "expected_match": true,
        "event": {
          "EventID": 7045,
          "Channel": "System",
          "Provider_Name": "Service Control Manager",
          "ServiceName": "LibraryRunner",
          "ImagePath": "\\Windows\\System32\\rundll32.exe \\ProgramData\\LibraryRunner\\runner.dll,Start",
          "ServiceType": "user mode service",
          "StartType": "auto start"
        }
      },
      {
        "id": "pos-007-system-7045-script-like-ps1-target",
        "description": "Windows System 7045 service install with script-like service target",
        "telemetry_source": "Windows System 7045",
        "behavior": "script-like service target",
        "expected_match": true,
        "event": {
          "EventID": 7045,
          "Channel": "System",
          "Provider_Name": "Service Control Manager",
          "ServiceName": "ScriptedService",
          "ImagePath": "\\ProgramData\\ScriptedService\\service.ps1",
          "ServiceType": "user mode service",
          "StartType": "demand start"
        }
      }
    ],
    "negative": [
